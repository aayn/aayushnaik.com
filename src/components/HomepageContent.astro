---
// src/components/HomepageContent.astro — static homepage content with CSS staggered fade-in
// Design: docs/superpowers/brainstorm/2026-10-12-homepage-even-if/one-line/01-baseline.html
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="ext-link" viewBox="0 0 16 16">
    <path d="M7 3H3.5A1.5 1.5 0 0 0 2 4.5v8A1.5 1.5 0 0 0 3.5 14h8a1.5 1.5 0 0 0 1.5-1.5V9" />
    <path d="M9 2h5v5M14 2 7.5 8.5" />
  </symbol>
</svg>

<div class="home-content relative px-[60px] py-[60px] text-[15px] lg:text-[17px] 2xl:text-[21px] leading-[1.75]" style="z-index: 2;">
  <p class="fade-in m-0" style="animation-delay: 0.10s;">
    I'm building <a href="https://hypercubic.ai" target="_blank" rel="noopener noreferrer" class="ext">Hypercubic<svg class="ico"><use href="#ext-link" /></svg></a> and I <a href="https://www.anticynical.com/" target="_blank" rel="noopener noreferrer" class="ext">write<svg class="ico"><use href="#ext-link" /></svg></a> sometimes.
  </p>
  <p class="fade-in m-0 mt-[1.75em]" style="animation-delay: 0.30s;">
    -- Aayush Naik
  </p>
</div>

<style>
  /* Light: paper ground, solid ink, duller violet, soft underline. Dark: thin white, pale lavender. */
  .home-content {
    --ink: #111;
    --lav: #4a3fa8;
    --ul: rgba(74, 63, 168, 0.35);
    color: var(--ink);
    font-weight: 400;
  }
  :global(html.dark) .home-content {
    --ink: rgba(255, 255, 255, 0.88);
    --lav: #a99bff;
    --ul: #a99bff;
    font-weight: 300;
  }
  .fade-in {
    opacity: 0;
    transform: translateY(14px);
    animation: enter 0.9s ease forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .fade-in { animation: none; opacity: 1; transform: none; }
  }
  .ext {
    color: var(--lav);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--ul);
    transition: text-decoration-color 0.2s;
  }
  .ext:hover {
    text-decoration-color: transparent;
  }
  .ico {
    display: inline-block; /* Tailwind preflight makes svg block-level */
    width: 0.72em;
    height: 0.72em;
    margin-left: 0.18em;
    vertical-align: -0.02em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
